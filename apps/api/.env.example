PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://voxa:voxa_local_only@localhost:5432/voxa?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-at-least-32-random-characters-before-running
CORS_ORIGINS=http://localhost:19006,http://localhost:3000
FRONTEND_URL=http://localhost:3001
# Resend account email delivery (required in production for verification and recovery)
RESEND_API_KEY=
EMAIL_FROM=VOXA <accounts@your-domain.example>

# S3-compatible media storage (AWS S3, Cloudflare R2, or MinIO)
S3_REGION=auto
S3_BUCKET=voxa-media
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_UPLOAD_URL_TTL_SECONDS=600
S3_PLAYBACK_URL_TTL_SECONDS=3600
MEDIA_MAX_AUDIO_BYTES=524288000
MEDIA_MAX_VIDEO_BYTES=2147483648

# LiveKit Cloud or self-hosted LiveKit server (never expose API secret to clients)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LiveKit Egress room recordings upload directly to S3-compatible storage.
# Keep disabled until participant consent, storage permissions, and retention are reviewed.
LIVEKIT_RECORDING_S3_BUCKET=
LIVEKIT_RECORDING_S3_ACCESS_KEY=
LIVEKIT_RECORDING_S3_SECRET_KEY=
LIVEKIT_RECORDING_S3_REGION=auto
LIVEKIT_RECORDING_S3_ENDPOINT=

# Paystack server-side credentials (never expose these as NEXT_PUBLIC variables)
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=https://your-domain.example/payment/complete

# Keep false until Paystack approves VOXA for Transfers and staging verification is complete.
PAYSTACK_TRANSFERS_ENABLED=false
PAYSTACK_PAYOUT_EXECUTION_ENABLED=false

# Keep disabled until staging concurrency tests and monitoring are complete.
SETTLEMENT_WORKER_ENABLED=false
SETTLEMENT_WORKER_INTERVAL_MS=60000

# Media processing worker (run as a separate isolated process)
MEDIA_WORKER_INTERVAL_MS=5000
MEDIA_WORKER_STALE_MS=3600000
MEDIA_WORKER_MAX_ATTEMPTS=3

# Generate a base64-encoded 32-byte key for AES-256-GCM MFA secret encryption.
MFA_ENCRYPTION_KEY=

# Optional AI episode transcription. When configured, the media worker
# creates a transcript after media processing; existing creator transcripts
# are preserved. Episodes whose compressed audio exceeds 24 MB are skipped.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
