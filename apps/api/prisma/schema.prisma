generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  LISTENER
  CREATOR
  MODERATOR
  ADMIN
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MediaProcessingStatus {
  UPLOADED
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum LiveRoomStatus {
  DRAFT
  SCHEDULED
  LIVE
  ENDED
  PROCESSING
  REPLAY_AVAILABLE
  CANCELLED
}

enum LiveRoomVisibility {
  PUBLIC
  UNLISTED
  MEMBERS_ONLY
  PRIVATE
}

model User {
  id          String     @id @default(cuid())
  email       String     @unique
  passwordHash String
  displayName String
  role        UserRole   @default(LISTENER)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  creator     Creator?
  follows     Follow[]   @relation("Follower")
  liveRooms   LiveRoom[] @relation("RoomHost")
  bookmarks   EpisodeBookmark[]
  playbackProgress PlaybackProgress[]
}

model Creator {
  id          String   @id @default(cuid())
  userId      String   @unique
  handle      String   @unique
  bio         String?
  verifiedAt  DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shows       Show[]
  followers   Follow[]
}

model Show {
  id          String    @id @default(cuid())
  creatorId   String
  title       String
  description String?
  language    String    @default("en")
  category    String?
  artworkUrl  String?
  status      PublicationStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  creator     Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  episodes    Episode[]
}

model Episode {
  id              String   @id @default(cuid())
  showId          String
  title           String
  description     String?
  mediaKey        String?
  artworkUrl      String?
  durationSeconds Int?
  isExplicit      Boolean  @default(false)
  status          PublicationStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  show            Show     @relation(fields: [showId], references: [id], onDelete: Cascade)
  bookmarks       EpisodeBookmark[]
  progress        PlaybackProgress[]
  mediaAssets     MediaAsset[]

  @@index([showId, status, publishedAt])
}

model MediaAsset {
  id              String                @id @default(cuid())
  episodeId       String
  objectKey       String                @unique
  contentType     String
  sizeBytes       BigInt
  status          MediaProcessingStatus @default(UPLOADED)
  durationSeconds Int?
  width           Int?
  height          Int?
  playbackKey     String?
  failureReason   String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  processedAt     DateTime?
  episode         Episode               @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([episodeId, createdAt])
  @@index([status, createdAt])
}

model Follow {
  followerId String
  creatorId  String
  createdAt  DateTime @default(now())
  follower   User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  creator    Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@id([followerId, creatorId])
  @@index([creatorId, createdAt])
}

model EpisodeBookmark {
  userId    String
  episodeId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@id([userId, episodeId])
  @@index([userId, createdAt])
}

model PlaybackProgress {
  userId          String
  episodeId       String
  positionSeconds Int      @default(0)
  completed       Boolean  @default(false)
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode         Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@id([userId, episodeId])
  @@index([userId, updatedAt])
}

model LiveRoom {
  id          String             @id @default(cuid())
  hostId      String
  title       String
  description String?
  status      LiveRoomStatus     @default(DRAFT)
  visibility  LiveRoomVisibility @default(PUBLIC)
  isAudioOnly Boolean            @default(false)
  scheduledAt DateTime?
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime           @default(now())
  host        User               @relation("RoomHost", fields: [hostId], references: [id])
  stage       LiveStageMember[]
  requests    StageRequest[]

  @@index([status, scheduledAt])
}

model LiveStageMember {
  id       String   @id @default(cuid())
  roomId   String
  userId   String
  role     String
  joinedAt DateTime @default(now())
  leftAt   DateTime?
  room     LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

model StageRequest {
  id          String   @id @default(cuid())
  roomId      String
  userId      String
  status      String   @default("PENDING")
  requestedAt DateTime @default(now())
  decidedAt   DateTime?
  room        LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId, status, requestedAt])
}
