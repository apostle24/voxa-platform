generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  LISTENER
  CREATOR
  MODERATOR
  ADMIN
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MediaProcessingStatus {
  UPLOADED
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum LiveRoomStatus {
  DRAFT
  SCHEDULED
  LIVE
  ENDED
  PROCESSING
  REPLAY_AVAILABLE
  CANCELLED
}

enum LiveRoomVisibility {
  PUBLIC
  UNLISTED
  MEMBERS_ONLY
  PRIVATE
}

enum MembershipInterval {
  MONTH
}

enum MembershipSubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum LedgerAccountType {
  CREATOR_AVAILABLE
  CREATOR_PENDING
  PLATFORM_CLEARING
  PLATFORM_REVENUE
  PROVIDER_FEE_EXPENSE
  CREATOR_PAYOUT_HOLD
}

enum PayoutRequestStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  SUBMITTED
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum LedgerEntryDirection {
  DEBIT
  CREDIT
}

enum PaymentAttemptStatus {
  INITIALIZED
  PAID
  FAILED
}

enum ReportTargetType {
  EPISODE
  MOMENT
  LIVE_ROOM
  USER
  COMMUNITY_POST
}

enum ReportReason {
  HARASSMENT
  HATE
  VIOLENCE
  SEXUAL_CONTENT
  SPAM
  COPYRIGHT
  SELF_HARM
  OTHER
}

enum ReportStatus {
  NEW
  REVIEWING
  ACTIONED
  DISMISSED
}

model User {
  id          String     @id @default(cuid())
  email       String     @unique
  passwordHash String
  displayName String
  role        UserRole   @default(LISTENER)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  suspendedUntil DateTime?
  suspensionReason String?
  creator     Creator?
  follows     Follow[]   @relation("Follower")
  liveRooms   LiveRoom[] @relation("RoomHost")
  liveChatMessages LiveChatMessage[]
  bookmarks   EpisodeBookmark[]
  playbackProgress PlaybackProgress[]
  episodeComments EpisodeComment[]
  episodeLikes EpisodeLike[]
  momentLikes MomentLike[]
  momentComments MomentComment[]
  notifications Notification[]
  notificationDevices NotificationDevice[]
  notificationPreference NotificationPreference?
  membershipSubscriptions MembershipSubscription[] @relation("SubscriberSubscriptions")
  ledgerAccounts LedgerAccount[]
  paymentAttempts PaymentAttempt[]
  authSessions AuthSession[]
  emailVerifiedAt DateTime?
  emailActionTokens EmailActionToken[]
  mfaCredential MfaCredential?
  mfaChallenges MfaLoginChallenge[]
  communitiesOwned Community[]
  communityMemberships CommunityMember[]
  communityPosts CommunityPost[]
  communityPostComments CommunityPostComment[]
  submittedReports ContentReport[] @relation("ReportSubmitter")
  reviewedReports ContentReport[] @relation("ReportReviewer")
  moderationActions ModerationAction[]
  blocksMade UserBlock[] @relation("UserBlocksMade")
  blocksReceived UserBlock[] @relation("UserBlocksReceived")
}

model Creator {
  id          String   @id @default(cuid())
  userId      String   @unique
  handle      String   @unique
  bio         String?
  verifiedAt  DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shows       Show[]
  moments     Moment[]
  followers   Follow[]
  membershipPlans MembershipPlan[]
  subscriptions MembershipSubscription[] @relation("CreatorSubscriptions")
  paymentAttempts PaymentAttempt[]
  payoutDestinations CreatorPayoutDestination[]
  payoutRequests PayoutRequest[]
}

model Show {
  id          String    @id @default(cuid())
  creatorId   String
  title       String
  description String?
  language    String    @default("en")
  category    String?
  artworkUrl  String?
  status      PublicationStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  creator     Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  episodes    Episode[]
}

model Episode {
  id              String   @id @default(cuid())
  showId          String
  title           String
  description     String?
  mediaKey        String?
  artworkUrl      String?
  durationSeconds Int?
  isExplicit      Boolean  @default(false)
  membershipRequired Boolean @default(false)
  isLiveReplay     Boolean  @default(false)
  status          PublicationStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  show            Show     @relation(fields: [showId], references: [id], onDelete: Cascade)
  bookmarks       EpisodeBookmark[]
  progress        PlaybackProgress[]
  mediaAssets     MediaAsset[]
  moments         Moment[]
  comments        EpisodeComment[]
  transcript      EpisodeTranscript?
  intelligence    EpisodeIntelligence?
  chapters        EpisodeChapter[]
  likes           EpisodeLike[]

  @@index([showId, status, publishedAt])
}

model MediaAsset {
  id              String                @id @default(cuid())
  episodeId       String
  objectKey       String                @unique
  contentType     String
  sizeBytes       BigInt
  status          MediaProcessingStatus @default(UPLOADED)
  durationSeconds Int?
  width           Int?
  height          Int?
  playbackKey     String?
  failureReason   String?
  processingAttempts Int @default(0)
  processingStartedAt DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  processedAt     DateTime?
  episode         Episode               @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([episodeId, createdAt])
  @@index([status, createdAt])
}

model Follow {
  followerId String
  creatorId  String
  createdAt  DateTime @default(now())
  follower   User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  creator    Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@id([followerId, creatorId])
  @@index([creatorId, createdAt])
}


model EpisodeComment {
  id        String   @id @default(cuid())
  episodeId String
  authorId  String
  parentId  String?
  content   String
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    EpisodeComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   EpisodeComment[] @relation("CommentReplies")

  @@index([episodeId, createdAt])
  @@index([parentId, createdAt])
  @@index([authorId, createdAt])
}

model EpisodeLike {
  userId    String
  episodeId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@id([userId, episodeId])
  @@index([episodeId, createdAt])
}

model Moment {
  id           String   @id @default(cuid())
  creatorId    String
  episodeId    String
  caption      String
  startSeconds Int
  endSeconds   Int
  status       PublicationStatus @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  creator      Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  episode      Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  likes        MomentLike[]
  comments     MomentComment[]

  @@index([status, publishedAt])
  @@index([creatorId, createdAt])
  @@index([episodeId, status])
}

model MomentLike {
  userId    String
  momentId  String
  createdAt DateTime @default(now())
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  moment    Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)

  @@id([userId, momentId])
  @@index([momentId, createdAt])
}

model MomentComment {
  id        String   @id @default(cuid())
  momentId  String
  authorId  String
  parentId  String?
  content   String
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    MomentComment? @relation("MomentCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   MomentComment[] @relation("MomentCommentReplies")

  @@index([momentId, createdAt])
  @@index([parentId, createdAt])
  @@index([authorId, createdAt])
}

model EpisodeBookmark {
  userId    String
  episodeId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@id([userId, episodeId])
  @@index([userId, createdAt])
}

model PlaybackProgress {
  userId          String
  episodeId       String
  positionSeconds Int      @default(0)
  completed       Boolean  @default(false)
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode         Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@id([userId, episodeId])
  @@index([userId, updatedAt])
}

model LiveRoom {
  id          String             @id @default(cuid())
  hostId      String
  title       String
  description String?
  status      LiveRoomStatus     @default(DRAFT)
  visibility  LiveRoomVisibility @default(PUBLIC)
  isAudioOnly Boolean            @default(false)
  scheduledAt DateTime?
  startedAt   DateTime?
  endedAt     DateTime?
  peakAudienceCount Int @default(0)
  recordingStatus String @default("NOT_STARTED")
  recordingEgressId String? @unique
  recordingObjectKey String?
  recordingConsentAt DateTime?
  recordingStartedAt DateTime?
  recordingEndedAt DateTime?
  recordingFailure String?
  createdAt   DateTime           @default(now())
  host        User               @relation("RoomHost", fields: [hostId], references: [id])
  stage       LiveStageMember[]
  requests    StageRequest[]
  chatMessages LiveChatMessage[]
  viewerSessions LiveViewerSession[]

  @@index([status, scheduledAt])
}


model LiveViewerSession {
  id         String   @id @default(cuid())
  roomId     String
  userId     String
  sessionId  String
  joinedAt   DateTime @default(now())
  lastSeenAt DateTime @default(now())
  leftAt     DateTime?
  room       LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, sessionId])
  @@index([roomId, leftAt, lastSeenAt])
  @@index([roomId, userId, leftAt])
}

model LiveChatMessage {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  content   String
  deletedAt DateTime?
  createdAt DateTime @default(now())
  room      LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([userId, createdAt])
}

model LiveStageMember {
  id       String   @id @default(cuid())
  roomId   String
  userId   String
  role     String
  joinedAt DateTime @default(now())
  leftAt   DateTime?
  room     LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

model StageRequest {
  id          String   @id @default(cuid())
  roomId      String
  userId      String
  status      String   @default("PENDING")
  requestedAt DateTime @default(now())
  decidedAt   DateTime?
  room        LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId, status, requestedAt])
}

model Notification {
  id          String   @id @default(cuid())
  recipientId String
  actorId     String?
  type        String
  title       String
  body        String?
  resourceType String?
  resourceId  String?
  readAt      DateTime?
  createdAt   DateTime @default(now())
  recipient  User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
  @@index([recipientId, createdAt])
}



model NotificationDevice {
  id             String   @id @default(cuid())
  userId         String
  expoPushToken  String   @unique
  platform       String
  deviceName     String?
  enabled        Boolean  @default(true)
  lastRegisteredAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled])
}

model NotificationPreference {
  id               String   @id @default(cuid())
  userId           String   @unique
  follows          Boolean  @default(true)
  comments         Boolean  @default(true)
  community        Boolean  @default(true)
  liveInvitations  Boolean  @default(true)
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model MembershipPlan {
  id          String   @id @default(cuid())
  creatorId   String
  name        String
  description String?
  priceMinor  Int
  currency    String   @default("USD")
  interval    MembershipInterval @default(MONTH)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  creator     Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  subscriptions MembershipSubscription[]
  paymentAttempts PaymentAttempt[]

  @@index([creatorId, isActive, createdAt])
}

model MembershipSubscription {
  id                     String   @id @default(cuid())
  subscriberId           String
  creatorId              String
  planId                 String
  priceMinor             Int
  currency               String   @default("USD")
  status                 MembershipSubscriptionStatus @default(PENDING)
  provider               String?
  providerSubscriptionId String?  @unique
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  subscriber             User     @relation("SubscriberSubscriptions", fields: [subscriberId], references: [id], onDelete: Cascade)
  creator                Creator  @relation("CreatorSubscriptions", fields: [creatorId], references: [id], onDelete: Cascade)
  plan                   MembershipPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@unique([subscriberId, creatorId])
  @@index([creatorId, status, currentPeriodEnd])
  @@index([subscriberId, status, currentPeriodEnd])
}

model LedgerAccount {
  id        String   @id @default(cuid())
  ownerId   String?
  accountKey String  @unique
  type      LedgerAccountType
  currency  String
  createdAt DateTime @default(now())
  owner     User?    @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  entries   LedgerEntry[]

  @@unique([ownerId, type, currency])
  @@index([ownerId, currency])
}

model LedgerTransaction {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique
  type           String
  currency       String
  amountMinor    Int
  status         String   @default("POSTED")
  reference      String?
  createdAt      DateTime @default(now())
  entries        LedgerEntry[]

  @@index([type, createdAt])
  @@index([reference])
}

model LedgerEntry {
  id            String   @id @default(cuid())
  transactionId String
  accountId     String
  direction     LedgerEntryDirection
  amountMinor   Int
  createdAt     DateTime @default(now())
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account       LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([transactionId, accountId, direction])
  @@index([accountId, createdAt])
}


model PaymentAttempt {
  id          String   @id @default(cuid())
  userId      String
  creatorId   String
  planId      String
  provider    String
  reference   String   @unique
  amountMinor Int
  currency    String
  status      PaymentAttemptStatus @default(INITIALIZED)
  platformFeeBps Int @default(1500)
  platformFeeMinor Int
  creatorNetMinor Int
  providerFeeMinor Int?
  providerFeeRecordedAt DateTime?
  checkoutUrl String?
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  creator     Creator  @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  plan        MembershipPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([creatorId, status, createdAt])
}

model CreatorPayoutDestination {
  id                    String   @id @default(cuid())
  creatorId             String
  provider              String
  providerRecipientCode String   @unique
  currency              String
  country               String
  channel               String
  accountName           String
  maskedAccountNumber   String
  isVerified            Boolean  @default(false)
  isDefault             Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  creator               Creator  @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  payoutRequests        PayoutRequest[]

  @@index([creatorId, isDefault, createdAt])
}

model PayoutRequest {
  id                   String   @id @default(cuid())
  creatorId            String
  destinationId        String
  provider             String
  reference            String   @unique
  idempotencyKey       String   @unique
  amountMinor          Int
  currency             String
  status               PayoutRequestStatus @default(REQUESTED)
  providerTransferCode String?  @unique
  failureReason        String?
  requestedAt          DateTime @default(now())
  reviewedAt           DateTime?
  paidAt               DateTime?
  updatedAt             DateTime @updatedAt
  creator               Creator  @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  destination           CreatorPayoutDestination @relation(fields: [destinationId], references: [id], onDelete: Restrict)

  @@index([creatorId, status, requestedAt])
  @@index([provider, status, requestedAt])
}

model FinancialAuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model PaymentWebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventKey    String
  eventType   String
  reference   String?
  payload     Json
  receivedAt  DateTime @default(now())
  processedAt DateTime?

  @@unique([provider, eventKey])
  @@index([reference, provider])
}


model AuthSession {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  replacedById String?
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
}


model LiveKitWebhookEvent {
  eventId             String   @id
  eventType           String
  roomId              String?
  participantIdentity String?
  receivedAt          DateTime @default(now())

  @@index([roomId, eventType, receivedAt])
  @@index([participantIdentity, receivedAt])
}


model EmailActionToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  purpose    String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, consumedAt, expiresAt])
}

model MfaCredential {
  id              String   @id @default(cuid())
  userId          String   @unique
  encryptedSecret String
  enabledAt       DateTime?
  lastTotpCounter Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  backupCodes     MfaBackupCode[]
}

model MfaBackupCode {
  id           String   @id @default(cuid())
  credentialId String
  codeHash     String   @unique
  consumedAt   DateTime?
  createdAt    DateTime @default(now())
  credential   MfaCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([credentialId, consumedAt])
}

model MfaLoginChallenge {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt, consumedAt])
}


model Community {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  slug        String   @unique
  description String?
  category    String?
  artworkUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members     CommunityMember[]
  posts       CommunityPost[]

  @@index([category, createdAt])
  @@index([ownerId, createdAt])
}

model CommunityMember {
  communityId String
  userId      String
  role        String   @default("MEMBER")
  joinedAt    DateTime @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([communityId, userId])
  @@index([userId, joinedAt])
}

model CommunityPost {
  id          String   @id @default(cuid())
  communityId String
  authorId    String
  content     String
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments    CommunityPostComment[]

  @@index([communityId, createdAt])
  @@index([authorId, createdAt])
  @@index([deletedAt])
}


model CommunityPostComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId, createdAt])
}

model EpisodeTranscript {
  id        String   @id @default(cuid())
  episodeId String   @unique
  content   String   @db.Text
  language  String   @default("en")
  segments  Json?
  updatedAt DateTime @updatedAt
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
}

model EpisodeChapter {
  id           String   @id @default(cuid())
  episodeId    String
  title        String
  startSeconds Int
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  episode      Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([episodeId, startSeconds])
  @@index([episodeId, position])
}

model EpisodeIntelligence {
  id          String   @id @default(cuid())
  episodeId   String   @unique
  summary     String   @db.Text
  topics      Json
  model       String
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
  episode     Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
}

model ContentReport {
  id             String           @id @default(cuid())
  reporterId     String
  targetType     ReportTargetType
  targetId       String
  reason         ReportReason
  details        String?
  status         ReportStatus     @default(NEW)
  reviewerId     String?
  moderatorNote  String?
  reviewedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  reporter       User             @relation("ReportSubmitter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewer       User?            @relation("ReportReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([reporterId, createdAt])
}

model ModerationAction {
  id         String   @id @default(cuid())
  actorId    String
  reportId   String
  targetType String
  targetId   String
  action     String
  reason     String
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([reportId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
}

model UserBlock {
  id            String   @id @default(cuid())
  blockerId     String
  blockedUserId String
  createdAt     DateTime @default(now())
  blocker       User     @relation("UserBlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedUser   User     @relation("UserBlocksReceived", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedUserId])
  @@index([blockerId, createdAt])
  @@index([blockedUserId, createdAt])
}
