{
  "expo": {
    "name": "VOXA",
    "slug": "voxa",
    "scheme": "voxa",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.voxa.mobile" },
    "android": { "package": "com.voxa.mobile", "permissions": ["RECORD_AUDIO", "MODIFY_AUDIO_SETTINGS"] },
    "plugins": ["expo-secure-store", "expo-av"]
  }
}
