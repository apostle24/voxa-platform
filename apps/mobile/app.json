{
  "expo": {
    "name": "VOXA",
    "slug": "voxa",
    "scheme": "voxa",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.voxa.mobile"
    },
    "android": {
      "package": "com.voxa.mobile"
    },
    "plugins": [
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow VOXA to access your microphone for live rooms.",
          "enableBackgroundPlayback": true
        }
      ],
      "expo-secure-store",
      "expo-dev-client",
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          }
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Allow VOXA to access your microphone for live rooms."
        }
      ]
    ]
  }
}
