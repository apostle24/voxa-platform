NODE_ENV=development
JWT_SECRET=replace-with-at-least-32-random-characters-before-running
CORS_ORIGINS=http://localhost:19006,http://localhost:3000
PORT=3000
DATABASE_URL=postgresql://voxa:voxa_local_only@localhost:5432/voxa?schema=public
REDIS_URL=redis://localhost:6379
# Configure only in a secret manager or local untracked .env file.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
# Keep both false until Paystack approves Transfers and staging tests pass.
PAYSTACK_TRANSFERS_ENABLED=false
PAYSTACK_PAYOUT_EXECUTION_ENABLED=false
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:3000/payment/complete
# Enable the API's scheduled seven-day creator settlement release worker explicitly.
SETTLEMENT_WORKER_ENABLED=false
# Worker checks for matured payments at this interval (minimum 15 seconds).
SETTLEMENT_WORKER_INTERVAL_MS=60000

# Signed playback URL lifetime for long-form audio/video (max 21600 seconds).
S3_PLAYBACK_URL_TTL_SECONDS=3600
